{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "share": "disabled",
  "subagent_depth": 0,
  "permission": {
    "*": "deny"
  },
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://opencode.ai/inference/openai/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  }
}

